<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ImageProcessor.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="ImageProcessor.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        WindowStartupLocation="CenterScreen"
        Title="Image Enhancer AI (.NET Edition)"
        Width="900" Height="750" MinWidth="900" MinHeight="750">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Margin="15">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
            <TextBlock Text="Dark Theme"/>
            <ToggleSwitch IsChecked="{Binding IsDarkMode}" />
            <Button Content="⚙️" Command="{Binding OpenSettingsCommand}" CommandParameter="{Binding $parent[Window]}" ToolTip.Tip="Settings" Margin="5,0,0,0"/>
        </StackPanel>
        
        <SplitView Grid.Row="1" 
                   IsPaneOpen="{Binding ShowPreview}"
                   PanePlacement="Right"
                   DisplayMode="Inline">
            <SplitView.Content>
                <!-- Left Panel: Controls -->
                <StackPanel Spacing="10" Margin="0,0,10,0" MinWidth="480">
                    
                    <TextBlock Text="AI-Powered Batch Image Enhancement" Classes="h1" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Border Background="#40FF0000" BorderBrush="Red" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10"
                            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="White"/>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10" IsEnabled="{Binding IsUiEnabled}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Input Folder:"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InputFolder}" IsReadOnly="True"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Browse..." Command="{Binding BrowseInputFolderCommand}" CommandParameter="{Binding $parent[Window]}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Output Folder:"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputFolder}" IsReadOnly="True" IsEnabled="{Binding !UseInputFolderAsOutput}"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseOutputFolderCommand}" CommandParameter="{Binding $parent[Window]}" IsEnabled="{Binding !UseInputFolderAsOutput}"/>

                        <CheckBox Grid.Row="2" Grid.Column="1" Content="Use input folder as output folder" IsChecked="{Binding UseInputFolderAsOutput}" IsEnabled="{Binding CanSelectSameOutputFolder}"/>
                    </Grid>

                    <Separator Margin="0,5"/>

                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsUiEnabled}">
                        <TextBlock Text="AI Model:"/>
                        <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" MinWidth="200"/>
                    </StackPanel>

                    <Separator Margin="0,5"/>

                    <TextBlock Text="Processing Options" Classes="h3" IsVisible="{Binding IsUiEnabled}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" >
                        <TextBlock Text="Show Preview"/>
                        <ToggleSwitch IsChecked="{Binding ShowPreview}"/>
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsUiEnabled}" Margin="0,5,0,0">
                        <CheckBox Content="Apply 4x Upscale" IsChecked="{Binding ApplyUpscale}" Margin="0,0,15,5"/>
                        <CheckBox Content="Convert to .WebP" IsChecked="{Binding ConvertToWebP}" Margin="0,0,15,5"/>
                        <CheckBox Content="Convert to .AVIF" IsChecked="{Binding ConvertToAvif}" Margin="0,0,15,5"/>
                        <CheckBox Content="Process Subfolders" IsChecked="{Binding ProcessSubfolders}" Margin="0,0,15,5"/>
                        <CheckBox Content="Include .WebP Files" IsChecked="{Binding IncludeWebPFiles}" Margin="0,0,15,5"/>
                        <CheckBox Content="Include .Avif Files" IsChecked="{Binding IncludeAvifFiles}" Margin="0,0,15,5"/>
                        <CheckBox Content="Delete Source Files" IsChecked="{Binding DeleteSourceFile}" Foreground="Red"/>
                    </WrapPanel>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="Processing Status" Classes="h3"/>

                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding IsProcessing}" VerticalAlignment="Center">
                    <ProgressBar Grid.Column="0" Value="{Binding ProgressBarValue}" Minimum="0" Maximum="100" ShowProgressText="True" Margin="0 1" Height="20"/>
                    <TextBlock Grid.Column="1" IsVisible="{Binding TotalSpaceSaving.HasValue}"
                                   Text="{Binding TotalSpaceSaving, StringFormat=' {0:P1}'}"
                                   Margin="0,0,5,2" Classes="Monospace"/>
                    <TextBlock Grid.Column="2" IsVisible="{Binding TotalSpaceSaving.HasValue}"
                               Text="{Binding TotalSpaceSavingInMB}"
                               Margin="0,0,5,0" Classes="Monospace"/>
                    
                  </Grid>
                    

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" IsVisible="{Binding IsProcessing}" VerticalAlignment="Center">
                        <ProgressBar Grid.Column="0" Value="{Binding FolderProgressBarValue}" Minimum="0" Maximum="100" ShowProgressText="True" Margin="0 1" Height="20"/>
                        <TextBlock Grid.Column="1" IsVisible="{Binding FolderSpaceSaving.HasValue}"
                                   Text="{Binding FolderSpaceSaving, StringFormat=' {0:P1}'}"
                                   Margin="0,0,5,2" Classes="Monospace"/>
                        <TextBlock Grid.Column="2" IsVisible="{Binding FolderSpaceSaving.HasValue}"
                                   Text="{Binding FolderSpaceSavingInMB}"
                                   Margin="0,0,5,0" Classes="Monospace"/>
                    </Grid>

                    
                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsProcessing}" ColumnSpacing="5">
                        <TextBlock Grid.Column="0" Text="Folder:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentFolderName}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto" IsVisible="{Binding IsProcessing}" HorizontalAlignment="Left">
                        <TextBlock Grid.Column="0" HorizontalAlignment="Right" Classes="Caption">
                            <Run Text="("/>
                            <Run Text="{Binding ProcessedFilesInCurrentFolder}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding FilesInCurrentFolder}"/>
                            <Run Text=" files) "/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Classes="Caption Monospace">
                            <Run Text="{Binding HumanReadableFolderOriginalSize}"/>
                            <Run Text="{Binding HumanReadableFolderConvertedSize}"/>
                        </TextBlock>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsProcessing}" ColumnSpacing="5">
                        <TextBlock Grid.Column="0" Text="File:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding CurrentFile}"/>
                            <Run Text=" - "/>
                            <Run Text="{Binding HumanReadableCurrentFileSize}" Classes="Caption"/>
                        </TextBlock>
                    </Grid>

                    <!-- New TextBlock for preview error message -->
                    <TextBlock Text="{Binding PreviewErrorMessage}"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               IsVisible="{Binding PreviewErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Height="40" Classes="Caption"/>

                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5,0,0" IsVisible="{Binding IsProcessing}" HorizontalAlignment="Center">
                    <Button Content="Open Input Folder" Command="{Binding OpenInputFolderCommand}"/>
                    <Button Content="Open Output Folder" Command="{Binding OpenOutputFolderCommand}"/>
                  </StackPanel>
                    
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="10">
                        <Button Grid.Column="0" Content="Start Processing" Command="{Binding StartProcessingCommand}" IsEnabled="{Binding StartProcessingCommand.CanExecute}" HorizontalAlignment="Stretch" Classes="Accent" IsVisible="{Binding IsUiEnabled}"/>
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelProcessingCommand}" CommandParameter="{Binding $parent[Window]}" IsEnabled="{Binding CancelProcessingCommand.CanExecute}" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2" Content="View Log" Command="{Binding ViewLogCommand}" CommandParameter="{Binding $parent[Window]}" HorizontalAlignment="Stretch" IsVisible="{Binding IsUiEnabled}"/>
                    </Grid>
                    <Button Name="ExitButton" Content="Exit" HorizontalAlignment="Stretch" IsVisible="{Binding IsUiEnabled}"/>
                </StackPanel>
            </SplitView.Content>
            <SplitView.Pane>
                <!-- Right Panel: Preview -->
                <Border BorderBrush="Gray" BorderThickness="1,0,0,0" Padding="10,0,0,0" Margin="5,0,0,0"
                        MinWidth="400">
                    <Image Source="{Binding ImagePreview}" Stretch="Uniform"/>
                </Border>
            </SplitView.Pane>
        </SplitView>

        <!-- Confirmation Dialog -->
        <Grid Grid.Row="0" Grid.RowSpan="2" 
              IsVisible="{Binding IsDeleteConfirmationVisible}"
              Background="#80000000"> 
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="20" MinWidth="300">
                <StackPanel Spacing="10">
                    <TextBlock Text="Confirm Deletion" Classes="h3"/>
                    <TextBlock Text="Are you sure you want to permanently delete the original source files? This action cannot be undone."
                               TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                        <Button Grid.Column="0" Content="Yes, Delete"
                                Command="{Binding ConfirmDeleteAndStartCommand}"
                                Classes="destructive"/>
                        <Button Grid.Column="1" Content="No, Cancel"
                                Command="{Binding CancelDeleteCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>